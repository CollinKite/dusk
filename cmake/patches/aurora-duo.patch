+      (int)bounds.width, (int)bounds.height,
+      (int)(bounds.width * scale), (int)(bounds.height * scale), (float)scale,
+      (int)std::ceil(insets.left), (int)std::ceil(insets.top),
+      (int)std::ceil(insets.right), (int)std::ceil(insets.bottom)};
