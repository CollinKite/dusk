+
+@implementation AuroraMetalGeometryObserver
+- (instancetype)initWithFrame:(CGRect)frame {
+  self = [super initWithFrame:frame];
+  if (self) {
+    self.userInteractionEnabled = NO;
+    self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    self.backgroundColor = UIColor.clearColor;
+    self.hingeStatus = -1;
+    if (@available(iOS 17.0, *)) {
+      [self registerForTraitChanges:@[UITraitDisplayScale.class]
+                        withAction:@selector(updateGeometry)];
+    }
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 270100
+    if (@available(iOS 27.1, *)) {
+      __weak AuroraMetalGeometryObserver* weakSelf = self;
+      [self addInteraction:[[UIHingeInteraction alloc]
+          initWithUpdateHandler:^(UIHingeInteraction*, UIHingeInteractionUpdate* update) {
+        AuroraMetalGeometryObserver* observer = weakSelf;
+        if (!observer) return;
+        const NSInteger status = update.hinge ? (NSInteger)update.hinge.status : -1;
+        if (observer.hingeStatus != status) {
+          observer.hingeStatus = status;
+          SDL_Log("iOS hinge status changed: %ld", (long)status);
+          [observer updateGeometry];
+          [observer queueRefresh];
+        }
+      }]];
+    }
+#endif
+  }
+  return self;
+}
+- (void)layoutSubviews { [super layoutSubviews]; [self updateGeometry]; }
+- (void)safeAreaInsetsDidChange {
+  [super safeAreaInsetsDidChange];
+  [self updateGeometry];
+  [self queueRefresh];
+}
+- (void)didMoveToWindow {
+  [super didMoveToWindow];
+  [self updateGeometry];
+  [self queueRefresh];
+}
+- (void)updateGeometry {
+  UIView* metalView = self.superview;
+  if (!self.windowID || !metalView.window) return;
+  const CGSize bounds = metalView.bounds.size;
+  // Reading the local trait here also participates in automatic layout tracking.
+  const CGFloat scale = self.highDensity ? metalView.traitCollection.displayScale : 1.0;
+  if (bounds.width <= 0 || bounds.height <= 0 || !std::isfinite(scale) || scale <= 0) return;
+  const UIEdgeInsets insets = metalView.safeAreaInsets;
+  const aurora::webgpu::utils::UIKitMetalViewSize size{
+      (int)bounds.width, (int)bounds.height,
+      (int)(bounds.width * scale), (int)(bounds.height * scale), (float)scale,
+      (int)std::ceil(insets.left), (int)std::ceil(insets.top),
+      (int)std::ceil(insets.right), (int)std::ceil(insets.bottom)};
+  if (size.pixelWidth <= 0 || size.pixelHeight <= 0) return;
+  const bool scaleChanged = metalView.layer.contentsScale != scale;
+  if (scaleChanged) metalView.layer.contentsScale = scale;
+  bool changed;
+  {
+    std::lock_guard lock{s_geometryMutex};
+    auto& previous = s_geometry[self.windowID];
+    changed = previous != size;
+    previous = size;
+  }
+  if (changed || scaleChanged) {
+    CAMetalLayer* layer = (CAMetalLayer*)metalView.layer;
+    SDL_Log("iOS Metal view: %dx%d points, %dx%d pixels, scale %.2f; layer %.0fx%.0f, drawable %.0fx%.0f",
+            size.width, size.height, size.pixelWidth, size.pixelHeight, size.scale,
+            layer.bounds.size.width, layer.bounds.size.height, layer.drawableSize.width, layer.drawableSize.height);
+    [self queueRefresh];
+  }
+}
+- (void)queueRefresh {
+  if (self.refreshQueued || !self.windowID || !self.window) return;
+  self.refreshQueued = YES;
+  __weak AuroraMetalGeometryObserver* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    AuroraMetalGeometryObserver* observer = weakSelf;
+    if (!observer) return;
+    // Keep the coalescing flag set while sampling the settled view bounds.
+    [observer updateGeometry];
+    observer.refreshQueued = NO;
+    if (!observer.windowID || !observer.window || !SDL_GetWindowFromID(observer.windowID)) return;
+    SDL_Event event{};
+    event.type = SDL_EVENT_WINDOW_METAL_VIEW_RESIZED;
+    event.window.windowID = observer.windowID;
+    SDL_PushEvent(&event);
+  });
+}
+@end
+#endif
