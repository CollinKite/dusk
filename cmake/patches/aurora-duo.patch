index 0000000..f77107e
--- /dev/null
+++ b/cmake/patches/apply-sdl3-uikit-modern-window-bounds.cmake
@@ -0,0 +1,89 @@
+if (NOT DEFINED SDL_SOURCE_DIR OR SDL_SOURCE_DIR STREQUAL "")
+  message(FATAL_ERROR "SDL_SOURCE_DIR is required")
+endif ()
+
+set(_video "${SDL_SOURCE_DIR}/src/video/uikit/SDL_uikitvideo.m")
+if (NOT EXISTS "${_video}")
+  message(FATAL_ERROR "SDL UIKit video source is missing: ${_video}")
+endif ()
+
+# Match the entire known function so a future SDL change cannot silently
+# receive a partial patch. The visionOS function and legacy fallback stay intact.
+file(READ "${_video}" _source)
+set(_old [=[
+CGRect UIKit_ComputeViewFrame(SDL_Window *window, UIScreen *screen)
+{
+    SDL_UIKitWindowData *data = (__bridge SDL_UIKitWindowData *)window->internal;
+    CGRect frame = screen.bounds;
+
+    /* Use the UIWindow bounds instead of the UIScreen bounds, when possible.
+     * The uiwindow bounds may be smaller than the screen bounds when Split View
+     * is used on an iPad. */
+    if (data != nil && data.uiwindow != nil) {
+        frame = data.uiwindow.bounds;
+    }
+
+#ifndef SDL_PLATFORM_TVOS
+    /* iOS 10 seems to have a bug where, in certain conditions, putting the
+     * device to sleep with the a landscape-only app open, re-orienting the
+     * device to portrait, and turning it back on will result in the screen
+     * bounds returning portrait orientation despite the app being in landscape.
+     * This is a workaround until a better solution can be found.
+     * https://bugzilla.libsdl.org/show_bug.cgi?id=3505
+     * https://bugzilla.libsdl.org/show_bug.cgi?id=3465
+     * https://forums.developer.apple.com/thread/65337 */
+    UIInterfaceOrientation orient = [UIApplication sharedApplication].statusBarOrientation;
+    BOOL landscape = UIInterfaceOrientationIsLandscape(orient) ||
+                    !(UIKit_GetSupportedOrientations(window) & (UIInterfaceOrientationMaskPortrait | UIInterfaceOrientationMaskPortraitUpsideDown));
+    BOOL fullscreen = CGRectEqualToRect(screen.bounds, frame);
+
+    /* The orientation flip doesn't make sense when the window is smaller
+     * than the screen (iPad Split View, for example). */
+    if (fullscreen && (landscape != (frame.size.width > frame.size.height))) {
+        float height = frame.size.width;
+        frame.size.width = frame.size.height;
+        frame.size.height = height;
+    }
+#endif
+
+    return frame;
+}
+]=])
+set(_modern_window_bounds [=[
+
+    // Aurora local SDL fix: modern UIWindow bounds already use the correct
+    // coordinate space. The iOS 10 global-orientation workaround below can
+    // swap them back to a stale orientation during rotation or display changes.
+    if (@available(iOS 13.0, tvOS 13.0, *)) {
+        if (data != nil && data.uiwindow != nil) {
+            return data.uiwindow.bounds;
+        }
+    }
+
+    CGRect frame = screen.bounds;]=])
+string(REPLACE "    CGRect frame = screen.bounds;" "${_modern_window_bounds}" _new "${_old}")
+
+function(_count_exact text needle output)
+  string(REPLACE "${needle}" "" _remaining "${text}")
+  string(LENGTH "${text}" _text_length)
+  string(LENGTH "${_remaining}" _remaining_length)
+  string(LENGTH "${needle}" _needle_length)
+  math(EXPR _count "(${_text_length} - ${_remaining_length}) / ${_needle_length}")
+  set(${output} "${_count}" PARENT_SCOPE)
+endfunction()
+
+_count_exact("${_source}" "${_old}" _old_count)
+_count_exact("${_source}" "${_new}" _new_count)
+if (_old_count EQUAL 0 AND _new_count EQUAL 1)
+  message(STATUS "SDL3 UIKit modern window bounds patch already applied")
+  return()
+endif ()
+if (NOT _old_count EQUAL 1 OR NOT _new_count EQUAL 0)
+  message(FATAL_ERROR
+    "Failed to apply SDL3 UIKit modern window bounds patch: expected exactly one known "
+    "unpatched or patched UIKit_ComputeViewFrame function. Review the SDL revision and local changes.")
+endif ()
+
+string(REPLACE "${_old}" "${_new}" _patched_source "${_source}")
+file(WRITE "${_video}" "${_patched_source}")
+message(STATUS "Applied SDL3 UIKit modern window bounds patch")
