+          NSStringFromCGRect(metalView.frame), NSStringFromCGRect(metalView.bounds),
+          NSStringFromCGRect(layer.frame), NSStringFromCGRect(layer.bounds), NSStringFromCGSize(layer.drawableSize),
+          NSStringFromCGRect(metalView.window.bounds), scale);
