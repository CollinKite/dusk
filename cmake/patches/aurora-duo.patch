+// Observe SDL's own Metal view without replacing its view controller or scene.
+@interface AuroraMetalGeometryObserver : UIView
+@property(nonatomic) SDL_WindowID windowID;
+@property(nonatomic) BOOL highDensity;
+@property(nonatomic) BOOL refreshQueued;
+@property(nonatomic) NSInteger hingeStatus;
