+  const CGFloat scale = self.highDensity ? metalView.traitCollection.displayScale : 1.0;
+  if (bounds.width <= 0 || bounds.height <= 0 || !std::isfinite(scale) || scale <= 0) return;
+  const UIEdgeInsets insets = metalView.safeAreaInsets;
