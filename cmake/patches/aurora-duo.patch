diff --git a/lib/aux_window_ios.cpp b/lib/aux_window_ios.cpp
new file mode 100644
index 0000000..1fe6fa6
--- /dev/null
+++ b/lib/aux_window_ios.cpp
@@ -0,0 +1,93 @@
+#include <aurora/aux_window.hpp>
+#include "aux_window.hpp"
+#include "webgpu/gpu.hpp"
+
+#include <algorithm>
+#include <mutex>
+
+namespace aurora::auxwin {
+namespace {
+std::mutex s_mutex;
+wgpu::TextureView s_source;
+wgpu::Sampler s_sampler;
+uint32_t s_x = 0, s_y = 0, s_width = 0, s_height = 0;
+uint32_t s_sourceWidth = 0, s_sourceHeight = 0;
+float s_dim = 0;
+}
+
+void set_embedded_region(uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
+  std::lock_guard lock{s_mutex};
+  if (s_width != width || s_height != height) s_source = {};
+  s_x = x; s_y = y; s_width = width; s_height = height;
+}
+bool create(const CreateInfo&) { return is_open(); }
+bool is_open() noexcept {
+  std::lock_guard lock{s_mutex};
+  return s_width > 0 && s_height > 0;
+}
+void destroy() {
+  std::lock_guard lock{s_mutex};
+  s_source = {};
+  s_sampler = {};
+}
+void set_source(wgpu::TextureView view, uint32_t width, uint32_t height) {
+  std::lock_guard lock{s_mutex};
+  s_source = std::move(view); s_sourceWidth = width; s_sourceHeight = height;
+}
+void set_dim(float amount) {
+  std::lock_guard lock{s_mutex};
+  s_dim = std::clamp(amount, 0.f, 1.f);
+}
+bool get_surface_size(uint32_t* width, uint32_t* height) {
+  std::lock_guard lock{s_mutex};
+  if (width) *width = s_width;
+  if (height) *height = s_height;
+  return s_width > 0 && s_height > 0;
+}
+EmbeddedFrame freeze_embedded() {
+  std::lock_guard lock{s_mutex};
+  EmbeddedFrame result;
+  if (!s_source || !s_width || !s_height) return result;
+  if (!s_sampler) {
+    const wgpu::SamplerDescriptor descriptor{
+      .magFilter = wgpu::FilterMode::Linear,
+      .minFilter = wgpu::FilterMode::Linear,
+    };
+    s_sampler = webgpu::g_device.CreateSampler(&descriptor);
+  }
+  const webgpu::TextureWithSampler source{
+    .view = s_source,
+    .size = {s_sourceWidth, s_sourceHeight, 1},
+    .sampler = s_sampler,
+  };
+  result.source = webgpu::create_copy_bind_group(source);
+  result.dim = s_dim;
+  result.x = s_x; result.y = s_y;
+  result.width = s_width; result.height = s_height;
+  return result;
+}
+void render_embedded(const wgpu::RenderPassEncoder& pass, const EmbeddedFrame& frame,
+                     uint32_t surfaceWidth, uint32_t surfaceHeight) {
+  if (!frame.source || !frame.width || !frame.height) return;
+  // A native resize can invalidate a previously frozen panel. Skip that
+  // frame instead of submitting an out-of-bounds scissor to the new surface.
+  if (frame.x >= surfaceWidth || frame.y >= surfaceHeight ||
+      frame.width > surfaceWidth - frame.x || frame.height > surfaceHeight - frame.y) return;
+  pass.SetPipeline(webgpu::g_CopyDimPipeline);
+  pass.SetBindGroup(0, frame.source);
+  pass.SetViewport(frame.x, frame.y, frame.width, frame.height, 0.f, 1.f);
+  pass.SetScissorRect(frame.x, frame.y, frame.width, frame.height);
+  const double brightness = 1.0 - frame.dim;
+  const wgpu::Color blend{brightness, brightness, brightness, 1.0};
+  pass.SetBlendConstant(&blend);
+  pass.Draw(3);
+}
+
+// iOS uses the main swapchain; it never creates or presents a second window.
+void present() {}
+bool consume_close_request() { return false; }
+bool filter_event(const SDL_Event&) { return false; }
+void set_native_window(void*, uint32_t, uint32_t) {}
+void request_capture() {}
+bool take_capture(std::vector<uint8_t>&, uint32_t*, uint32_t*) { return false; }
+} // namespace aurora::auxwin
